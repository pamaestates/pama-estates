{
  "name": "pama-estates",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:pl-parity && npm run test:pl-safety && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:cost-controls": "node --test tests/blob-cost-controls.test.mjs",
    "test:pl-safety": "node --test tests/pl-safety.test.mjs",
    "test:pl-parity": "node --test tests/pl-source-drift.test.mjs && node scripts/check-pl-source-drift.mjs && npm run test:pl-routes",
    "test:pl-routes": "node --test tests/pl-route-parity.test.mjs && node scripts/check-pl-route-parity.mjs",
    "verify:pl-release": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@flags-sdk/vercel": "^1.6.0",
    "@vercel/blob": "2.8.1",
    "flags": "^4.4.0",
    "lucide-react": "^1.8.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
